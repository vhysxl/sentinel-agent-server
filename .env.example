# Postgres yang sama dengan sentinel-backend. Agent server memiliki tabel
# findings dan transaction_analysis; sisanya milik Drizzle di sentinel-backend.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Handshake antar-service. HARUS sama persis dengan AGENT_SERVER_KEY di
# sentinel-backend, kalau tidak setiap panggilan dijawab 401.
#
# Layanan ini gagal TERTUTUP: kalau variabel di bawah kosong, semua endpoint
# selain / menolak permintaan. Itu disengaja — agent server tidak punya auth
# lain, jadi kunci yang lupa dipasang tidak boleh berarti pintu terbuka.
#
# Hasilkan nilainya dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Verifikator (Agent 3) boleh memakai model lebih kuat. Kalau tidak diisi, ia
# memakai GEMINI_MODEL.
# GEMINI_MODEL_AGENT3=
